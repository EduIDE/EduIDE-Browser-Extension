{
    "manifest_version": 3,
    "name": "Open in EduIDE",
    "version": "0.2.0",
    "description": "Adds \"Open in EduIDE\" to GitHub's Code menu and opens the repository in an EduIDE session.",
    "minimum_chrome_version": "116",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "permissions": ["storage"],
    "optional_host_permissions": ["https://*/*", "http://*/*"],
    "background": {
        "service_worker": "src/background.js"
    },
    "action": {
        "default_title": "Open in EduIDE",
        "default_popup": "src/popup/popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    },
    "options_ui": {
        "page": "src/options/options.html",
        "open_in_tab": true
    },
    "content_scripts": [
        {
            "matches": ["https://github.com/*"],
            "js": ["src/lib/eduide.js", "src/content/github.js"],
            "run_at": "document_idle"
        }
    ]
}
